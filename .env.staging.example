# ============================================
# HuyPerfume — Staging Environment
# ============================================
# Copy to .env.staging and fill in real values.

NODE_ENV=staging
PORT=4000
CORS_ORIGIN=https://staging.huyperfume.com

DB_HOST=<SET_ME>
DB_PORT=1433
DB_NAME=huyperfume_staging
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=sa
DB_PASSWORD=<SET_ME>

JWT_SECRET=<SET_ME_STAGING_KEY>
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=604800000
PASSWORD_RESET_TOKEN_EXPIRATION_MS=900000
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MS=86400000
BCRYPT_ROUNDS=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=50
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_LOCK_MS=900000
AUTH_EXPOSE_DEV_TOKENS=true

REDIS_URL=redis://redis:6379
PRODUCT_CACHE_TTL_SECONDS=120
CHECKOUT_RESERVATION_TTL_SECONDS=600
CHECKOUT_LOCK_TTL_MS=10000
LOW_STOCK_THRESHOLD=5

APP_BASE_URL=https://staging.huyperfume.com
MOMO_PARTNER_CODE=<SET_ME>
MOMO_ACCESS_KEY=<SET_ME>
MOMO_SECRET_KEY=<SET_ME>
MOMO_IPN_SECRET=<SET_ME>
MOMO_PAY_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://staging.huyperfume.com/api/payment/momo/return
MOMO_IPN_URL=https://staging.huyperfume.com/api/payment/momo/ipn
ZALOPAY_APP_ID=<SET_ME>
ZALOPAY_KEY1=<SET_ME>
ZALOPAY_KEY2=<SET_ME>
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_REDIRECT_URL=https://staging.huyperfume.com/api/payment/zalopay/return

DEEPSEEK_API_KEY=<SET_ME>
DEEPSEEK_BASE_URL=https://api.deepseek.com

RUN_MIGRATIONS=true
