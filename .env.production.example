# ============================================
# HuyPerfume — Production Environment
# ============================================
# Copy this file to .env.production and fill in real values.
# .env.production is gitignored — never commit secrets.

NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://huyperfume.com

# --- SQL Server (external or Docker host) ---
DB_HOST=your-sqlserver-host
DB_PORT=1433
DB_NAME=huyperfume
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_USER=sa
DB_PASSWORD=<SET_ME>

# --- Auth ---
JWT_SECRET=<SET_ME_GENERATE_256_BIT_KEY>
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=604800000
PASSWORD_RESET_TOKEN_EXPIRATION_MS=900000
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MS=86400000
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW_MS=900000
LOGIN_LOCK_MS=900000
AUTH_EXPOSE_DEV_TOKENS=false

# --- Redis ---
REDIS_URL=redis://redis:6379
PRODUCT_CACHE_TTL_SECONDS=300
CHECKOUT_RESERVATION_TTL_SECONDS=900
CHECKOUT_LOCK_TTL_MS=10000
LOW_STOCK_THRESHOLD=5

# --- Payments ---
APP_BASE_URL=https://huyperfume.com
MOMO_PARTNER_CODE=<SET_ME>
MOMO_ACCESS_KEY=<SET_ME>
MOMO_SECRET_KEY=<SET_ME>
MOMO_IPN_SECRET=<SET_ME>
MOMO_PAY_URL=https://payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://huyperfume.com/api/payment/momo/return
MOMO_IPN_URL=https://huyperfume.com/api/payment/momo/ipn
ZALOPAY_APP_ID=<SET_ME>
ZALOPAY_KEY1=<SET_ME>
ZALOPAY_KEY2=<SET_ME>
ZALOPAY_CREATE_URL=https://openapi.zalopay.vn/v2/create
ZALOPAY_REDIRECT_URL=https://huyperfume.com/api/payment/zalopay/return

# --- AI ---
DEEPSEEK_API_KEY=<SET_ME>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Migration ---
RUN_MIGRATIONS=true
